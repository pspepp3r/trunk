{
	"name": "trunk/core",
	"description": "An async, API-centric PHP framework built on ReactPHP",
	"type": "library",
	"license": "MIT",
	"minimum-stability": "dev",
	"prefer-stable": true,
	"require": {
		"php": ">=8.1",
		"react/http": "^1.9",
		"react/promise": "^3.0",
		"react/mysql": "^0.7 || ^0.8",
		"voryx/pgasync": "^2.2",
		"firebase/php-jwt": "^6.10 || ^7.0",
		"react/child-process": "^0.6.7",
		"webonyx/graphql-php": "^15.0",
		"psr/http-message": "^1.0 || ^2.0",
		"psr/container": "^1.0 || ^2.0",
		"psr/log": "^1.0 || ^2.0 || ^3.0",
		"vlucas/phpdotenv": "^5.5"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5",
		"react/async": "^4.3"
	},
	"autoload": {
		"psr-4": {
			"Trunk\\": "src/"
		},
		"files": [
			"src/helpers.php"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"Trunk\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit"
	}
}
